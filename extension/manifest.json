{
  "manifest_version": 3,
  "name": "IntentAlign - YouTube Intent Alignment",
  "version": "1.0.0",
  "description": "AI-Based User-Intent Alignment and Adaptive Feed Intervention Plugin for YouTube.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://intentalign-youtube-extension.onrender.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IntentAlign - YouTube Intent Alignment"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}